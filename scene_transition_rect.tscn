[gd_scene format=3 uid="uid://dw4jktqg3w8ks"]

[sub_resource type="GDScript" id="GDScript_sk5ai"]
script/source = "extends ColorRect

# Reference to the _AnimationPlayer_ node
@onready var _anim_player := $AnimationPlayer

func _ready() -> void:
	# Plays the animation backward to fade in
	modulate.a = 1
	visible = true
	_anim_player.play(\"Fade-Out\")
	await _anim_player.animation_finished
	pass

func transition_to(tree:SceneTree, _next_scene:Node) -> void:
	# Plays the Fade animation and wait until it finishes
	_anim_player.play(\"Fade-In\")
	await _anim_player.animation_finished
	# Changes the scene
	tree.change_scene_to_node(_next_scene)
	
"

